# Keep HOST loopback unless API_KEY is configured and access is intentional.
HOST=127.0.0.1
PORT=3000
# External host port when deploying with Docker or Portainer.
PUBLISHED_PORT=3000
# Prebuilt image reference used by docker-compose.ghcr.yml.
GHCR_IMAGE=ghcr.io/aki-mizu/copilot-api:latest
API_KEY=replace-with-a-long-random-secret
# Fine-grained GitHub PAT with the Copilot Requests permission.
COPILOT_GITHUB_TOKEN=github_pat_replace-with-your-token
DEFAULT_MODEL=auto
REQUEST_TIMEOUT_SECONDS=120